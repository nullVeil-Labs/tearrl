# Normalize to LF in the repository regardless of platform, so a Windows
# checkout never rewrites history-visible line endings.
* text=auto eol=lf

*.png binary
*.jpg binary
*.pt  binary
*.npz binary
# Frozen preregistrations are addressed by byte-level SHA-256 digests.
# Preserve their original bytes across platforms; ordinary source remains LF.
docs/cc_prereg.md -text
docs/cc_implementation.md -text
docs/cc_v*_prereg.md -text
docs/cgs_prereg.md -text
docs/cgs_implementation.md -text
# Preserve raw machine-readable and narrative result bytes for audit digests.
reports/cgs/*.json -text
reports/cgs/*.md -text